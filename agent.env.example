# Copy to agent.env and fill in. agent.env is git-ignored – never commit it.
# Both values come from the mimamori page: Settings -> Agents -> Create agent key.

# Address of the mimamori server as this host reaches it: the HTTPS address of your reverse
# proxy, or http://mimamori:8000 when the agent shares the server's Docker network.
# Either way, every message is encrypted and signed with AGENT_KEY.
SERVER_URL=https://mimamori.example.com
AGENT_KEY=paste-agent-key-here

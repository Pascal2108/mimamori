# Copy to secrets.env and fill in. secrets.env is git-ignored – never commit it.
# Wrap a value in 'single quotes' if it contains $ or #.

# Login for the page (the password needs at least 12 characters)
ADMIN_USER=your-username
ADMIN_PASSWORD=a-long-secure-password

# Notifications: fill in the ones you want, remove the # in front of them.
#
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook
#
# Mail: the server and addresses are set in docker-compose.yml
# SMTP_PASSWORD=your-smtp-password
#
# Your own webhook, receives a JSON POST per alert. With the secret, every request is signed
# (see "Custom webhook" in the README). Generate the secret with: openssl rand -hex 32
# WEBHOOK_URL=https://hooks.example.com/mimamori
# WEBHOOK_SECRET=paste-random-key-here
